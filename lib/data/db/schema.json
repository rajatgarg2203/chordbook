  "fixed_sql": [
    {
      "name": "songs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"songs\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"album\" TEXT NULL, \"year\" INTEGER NULL, \"content\" TEXT NOT NULL, \"song_key\" TEXT NULL, \"capo\" INTEGER NULL, \"tempo\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "artists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"artists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL UNIQUE, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "song_artists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"song_artists\" (\"song_id\" TEXT NOT NULL REFERENCES songs (id), \"artist_id\" TEXT NOT NULL REFERENCES artists (id), \"position\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"song_id\", \"artist_id\"));"
        }
      ]
    },
    {
      "name": "tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL UNIQUE, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "song_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"song_tags\" (\"song_id\" TEXT NOT NULL REFERENCES songs (id), \"tag_id\" TEXT NOT NULL REFERENCES tags (id), PRIMARY KEY (\"song_id\", \"tag_id\"));"
        }
      ]
    }
